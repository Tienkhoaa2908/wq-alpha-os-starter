# Cơ sở dữ liệu và thư mục bằng chứng
ALPHA_OS_DB=data/db/alpha_lab.sqlite
ALPHA_OS_EVIDENCE_DIR=data/evidence

# BRAIN: chỉ điền trong .env tại máy, không chia sẻ hoặc đưa vào Git
BRAIN_EMAIL=
BRAIN_PASSWORD=
BRAIN_BASE_URL=https://api.worldquantbrain.com
BRAIN_TIMEOUT_SECONDS=60
BRAIN_POLL_SECONDS=10
BRAIN_MAX_POLLS=120

# Mô hình tại máy qua Ollama/Qwen hoặc máy chủ tương thích OpenAI
ALPHA_LLM_BASE_URL=http://localhost:11434/v1
# Bản 1.7B vừa bộ nhớ của máy hiện tại; dùng đầu nối mạnh hơn cho lứa quan trọng
ALPHA_LLM_MODEL=qwen3:1.7b
ALPHA_LLM_API_KEY=ollama
ALPHA_LLM_TIMEOUT_SECONDS=300

# Gemini API: chỉ điền GEMINI_API_KEY trong tệp .env, tuyệt đối không đưa vào Git.
# `alpha-os agent ...` luôn dùng Gemini. Với lệnh cũ `propose` hoặc `run`, đặt
# ALPHA_LLM_PROVIDER=gemini hoặc truyền --provider gemini.
ALPHA_LLM_PROVIDER=openai_compatible
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# `auto` hỏi GET /models bằng chính API key và chọn model generateContent tốt nhất
# đang khả dụng. Có thể ghi một model cụ thể; nếu model đó trả 404 provider sẽ
# tự resolve model khác thay vì làm hỏng cả research run.
GEMINI_MODEL=auto
GEMINI_API_KEY=

# Thiết lập mô phỏng mặc định
ALPHA_REGION=USA
ALPHA_UNIVERSE=TOP3000
ALPHA_DELAY=1
ALPHA_DECAY=6
ALPHA_TRUNCATION=0.01
ALPHA_NEUTRALIZATION=INDUSTRY
ALPHA_PASTEURIZATION=ON
ALPHA_NAN_HANDLING=OFF
ALPHA_UNIT_HANDLING=VERIFY
