# Cơ sở dữ liệu và thư mục bằng chứng
ALPHA_OS_DB=data/db/alpha_lab.sqlite
ALPHA_OS_EVIDENCE_DIR=data/evidence

# BRAIN: chỉ điền trong .env tại máy, không chia sẻ hoặc đưa vào Git
BRAIN_EMAIL=
BRAIN_PASSWORD=
BRAIN_BASE_URL=https://api.worldquantbrain.com
BRAIN_TIMEOUT_SECONDS=60
BRAIN_POLL_SECONDS=10
BRAIN_MAX_POLLS=120

# Provider nghiên cứu mặc định. auto_free thử Groq trước rồi OpenRouter.
# Nếu không có key nào, dùng workflow deterministic_no_llm để sinh AlphaPlan
# hoàn toàn cục bộ mà không cần LLM.
ALPHA_LLM_PROVIDER=auto_free
ALPHA_LLM_TIMEOUT_SECONDS=300

# Groq Free: ưu tiên reasoning/structured output.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# OpenRouter Free: fallback; model đầu là finance-specialized.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=inclusionai/ling-3.0-flash-fin:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Mô hình tại máy / server OpenAI-compatible cũ, chỉ dùng khi chủ động đặt
# ALPHA_LLM_PROVIDER=openai_compatible.
ALPHA_LLM_BASE_URL=http://localhost:11434/v1
ALPHA_LLM_MODEL=qwen3:1.7b
ALPHA_LLM_API_KEY=ollama

# Gemini giữ làm fallback thủ công, không còn là dependency bắt buộc của v2.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=auto
GEMINI_API_KEY=

# Thiết lập mô phỏng mặc định
ALPHA_REGION=USA
ALPHA_UNIVERSE=TOP3000
ALPHA_DELAY=1
ALPHA_DECAY=6
ALPHA_TRUNCATION=0.01
ALPHA_NEUTRALIZATION=INDUSTRY
ALPHA_PASTEURIZATION=ON
ALPHA_NAN_HANDLING=OFF
ALPHA_UNIT_HANDLING=VERIFY
